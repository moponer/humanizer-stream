{
  "name": "humanizer-stream",
  "version": "0.2.0",
  "description": "模型写作输出规则：把 AI 腔挡在生成之前。规则集 + 可注入的约束文本 + 体检器，零依赖。",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./rules": "./src/rules/index.js",
    "./check": "./src/check.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "deslop": "./bin/deslop.js"
  },
  "files": [
    "src",
    "bin",
    "adapters",
    "docs",
    "samples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "rules": "node bin/deslop.js rules --profile prose",
    "inject": "node bin/deslop.js inject --profile chat"
  },
  "keywords": [
    "ai-slop",
    "writing-rules",
    "system-prompt",
    "style-guide",
    "llm",
    "chinese"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "lynn contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moponer/humanizer-stream.git"
  },
  "bugs": {
    "url": "https://github.com/moponer/humanizer-stream/issues"
  },
  "homepage": "https://github.com/moponer/humanizer-stream#readme"
}
