{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "humanizer-stream config",
  "type": "object",
  "properties": {
    "profile": { "enum": ["prose", "chat", "mild", "code", "all"] },
    "lang": { "enum": ["zh", "en", "auto"] },
    "mode": { "enum": ["text", "code"] },
    "emoji": { "enum": ["strip", "keep"] },
    "comments": { "type": "boolean" },
    "tables": { "type": "boolean" },
    "unsafe": { "type": "boolean" },
    "tidy": { "type": "boolean" },
    "collapseBlank": { "type": "boolean" },
    "minEmit": { "type": "number", "minimum": 0 },
    "maxHold": { "type": "number", "minimum": 100 },
    "disabled": { "type": "array", "items": { "type": "string" } },
    "threshold": { "type": "number", "minimum": 0, "maximum": 100 }
  },
  "additionalProperties": true
}
